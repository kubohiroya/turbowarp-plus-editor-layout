{
  "name": "@kubohiroya/turbowarp-plus-editor-workbench",
  "version": "0.4.0",
  "description": "The TurboWarp Plus Editor workbench: layout, dockable sprite tabs, stage, debugger tab and file menu",
  "type": "module",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standard-layout": {
      "types": "./dist/standard-layout.d.ts",
      "default": "./dist/standard-layout.js"
    },
    "./stage-surface": {
      "types": "./dist/stage-surface.d.ts",
      "default": "./dist/stage-surface.js"
    },
    "./editor.css": "./src/editor.css",
    "./targets.css": "./src/targets.css",
    "./project-messages": {
      "types": "./dist/project-messages.d.ts",
      "default": "./dist/project-messages.js"
    },
    "./sprite-tabs": {
      "types": "./dist/sprite-tabs.d.ts",
      "default": "./dist/sprite-tabs.js"
    },
    "./sprite-layout-menu.css": "./src/sprite-layout-menu.css",
    "./dockview-styles": "./dist/dockview-styles.js",
    "./debugger-panel": {
      "types": "./dist/debugger-panel.d.ts",
      "default": "./dist/debugger-panel.js"
    },
    "./debugger-panel.css": "./src/debugger-panel.css",
    "./ai-agents": {
      "types": "./dist/ai-agents.d.ts",
      "default": "./dist/ai-agents.js"
    },
    "./extension-file-menu": {
      "types": "./dist/extension-file-menu.d.ts",
      "default": "./dist/extension-file-menu.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p example/tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.ts",
    "test:browser": "npm run build && node --test test/*.browser.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3",
    "jsdom": "26.1.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-editor-workbench.git"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-plus-editor-project-model": "0.1.0",
    "@kubohiroya/turbowarp-plus-editor-sprite-panes": "0.1.0",
    "dockview": "8.8.3"
  },
  "peerDependencies": {
    "react": ">=16.14",
    "react-dom": ">=16.14"
  }
}
